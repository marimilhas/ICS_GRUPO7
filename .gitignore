# .gitignore principal para varios proyectos (Python, Node, etc.)

# Archivos con secretos y configuración local - NUNCA SUBIR
.env
.env.*
!/.env.example
credentials.json
*.pem
*.key

# Dependencias y Entornos Virtuales
# ---------------------------------
# Python
.venv/
venv/
ENV/

# Node.js
node_modules/
jspm_packages/
bower_components/

# PHP (por si acaso)
vendor/

# Archivos de caché (generados automáticamente)
# --------------------------------------------
__pycache__/
.pytest_cache/
.parcel-cache/
.next/

# Archivos de build y compilados
# --------------------------------
build/
dist/
out/

# Logs y bases de datos locales
# -----------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
*.db
*.sqlite
*.sqlite3

# Basura del Sistema Operativo
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini

# Archivos de configuración de IDEs y editores
# --------------------------------------------
.idea/
.vscode/
*.suo
*.user
*.sublime-*

# Opcional: descomentar para compartir settings de VSCode con el equipo
# !.vscode/settings.json
# !.vscode/extensions.json

# Otros
# -----
# Archivos temporales de Vim y otros editores
*.swp
*~

# Archivos comprimidos
*.zip
*.rar
*.tar
*.gz